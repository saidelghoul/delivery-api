// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  SYSTEM_ADMIN
  DISPATCHER
  DRIVER
  SELLER
  CLIENT
}

enum VerificationType {
  REGISTRATION
  PASSWORD_RESET
}

enum Priority {
  NORMAL
  URGENT
  IMMEDIATE
}

enum RunStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PackageStatus {
  WAREHOUSE
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// --- MODELS ---

model Enterprise {
  id        String    @id @default(uuid())
  name      String
  users     User[]
  packages  Package[]
  createdAt DateTime  @default(now())

  @@map("enterprises")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  fullName            String
  role                UserRole
  isVerified          Boolean  @default(false)
  needsPasswordChange Boolean  @default(false)
  refreshToken        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Multi-tenancy
  enterpriseId String?
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id])

  // Relations
  verifications   Verification[]
  createdPackages Package[]      @relation("SellerPackages")
  
  // Ambiguous Relations: We must name them so Prisma knows which is which
  managedRuns  DeliveryRun[] @relation("DispatcherRuns")
  executedRuns DeliveryRun[] @relation("DriverRuns")

  @@map("users")
}

model Package {
  id            String        @id @default(uuid())
  price         Float
  clientAddress String
  priority      Priority      @default(NORMAL)
  status        PackageStatus @default(WAREHOUSE)

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  sellerId String
  seller   User   @relation("SellerPackages", fields: [sellerId], references: [id])

  // Connection to the shift
  runId       String?
  deliveryRun DeliveryRun? @relation(fields: [runId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model DeliveryRun {
  id     String    @id @default(uuid())
  status RunStatus @default(PENDING)

  dispatcherId String
  dispatcher   User   @relation("DispatcherRuns", fields: [dispatcherId], references: [id])

  driverId String
  driver   User   @relation("DriverRuns", fields: [driverId], references: [id])

  packages Package[]
  location DriverLocation?

  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())

  @@map("delivery_runs")
}

model DriverLocation {
  id          String      @id @default(uuid())
  runId       String      @unique
  deliveryRun DeliveryRun @relation(fields: [runId], references: [id])

  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt

  @@map("driver_locations")
}

model Verification {
  id        String           @id @default(uuid())
  code      String           // The 6-digit OTP
  type      VerificationType
  expiresAt DateTime
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verifications")
}